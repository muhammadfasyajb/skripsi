CREATE TABLE user_df (
    USER_ID INT PRIMARY KEY,
    USER_TYPE VARCHAR(50),
    USER_GENDER VARCHAR(10),
    TRAVEL_PURPOSE VARCHAR(100),
    USER_AGE INT
);

CREATE TABLE property_df (
    PROPERTY_CODE VARCHAR(50) PRIMARY KEY,
    CITY VARCHAR(100),
    DISTRICT VARCHAR(100),
    COHORT_DATE DATE,
    BRAND_TYPE VARCHAR(50),
    INVENTORY INT,
    OCCUPANCY_RATE FLOAT
);

CREATE TABLE booking_df (
    BOOKING_ID BIGINT PRIMARY KEY,
    USER_ID INT,
    PROPERTY_CODE VARCHAR(50),
    BOOKING_DATE DATE,
    CHECK_IN_DATE DATE,
    CHECK_OUT_DATE DATE,
    ROOMS INT,
    NIGHTS INT,
    ROOM_NIGHTS INT,
    REVENUE_DOLLAR FLOAT,
    STAY_DURATION INT,
    LEAD_TIME INT,
    Revenue_per_Night FLOAT,
    FOREIGN KEY (USER_ID) REFERENCES user_df(USER_ID),
    FOREIGN KEY (PROPERTY_CODE) REFERENCES property_df(PROPERTY_CODE)
);

