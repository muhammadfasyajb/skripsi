------ Determine customer segmentation based on purchasing behavior to identify a more focused target market ------
SELECT 
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY recency_days) AS recency_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY recency_days) AS recency_50,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY recency_days) AS recency_75,
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY REVENUE_DOLLAR) AS revenue_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY REVENUE_DOLLAR) AS revenue_50,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY REVENUE_DOLLAR) AS revenue_75,
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY FREQUENCY_BOOKING) AS freq_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY FREQUENCY_BOOKING) AS freq_50,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY FREQUENCY_BOOKING) AS freq_75,
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY REVENUE_PER_NIGHT) AS revnight_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY REVENUE_PER_NIGHT) AS revnight_50,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY REVENUE_PER_NIGHT) AS revnight_75,
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY stay_duration) AS stayduration_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY stay_duration) AS stayduration_50,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY stay_duration) AS stayduration_75
FROM (
    SELECT 
        b.USER_ID,
        SUM(b.REVENUE_DOLLAR) AS REVENUE_DOLLAR,
        COUNT(b.BOOKING_ID) AS FREQUENCY_BOOKING,
        AVG(b.REVENUE_PER_NIGHT) AS REVENUE_PER_NIGHT,
        AVG(b.stay_duration) AS stay_duration,
        (DATE '2024-11-07' - MAX(b.CHECK_OUT_DATE)) AS recency_days
    FROM booking_df b
    JOIN user_df u ON b.USER_ID = u.USER_ID
    GROUP BY b.USER_ID
) AS subquery;

ALTER TABLE user_df
ADD COLUMN revenue_segment VARCHAR,
ADD COLUMN frequency_segment VARCHAR,
ADD COLUMN revenue_per_night_segment VARCHAR,
ADD COLUMN recency_segment VARCHAR,
ADD COLUMN stay_duration_segment VARCHAR;

WITH segmentasi AS (
    SELECT 
        b.USER_ID,
        CASE --- revenue_segment
            WHEN SUM(b.REVENUE_DOLLAR) <= 1848.575 THEN 'Low Revenue'
            WHEN SUM(b.REVENUE_DOLLAR) > 1848.575 AND SUM(b.REVENUE_DOLLAR) <= 2000.565 THEN 'Medium Revenue'
            ELSE 'High Revenue'
        END AS revenue_segment,
        
        CASE --- frequency_segment
            WHEN COUNT(b.BOOKING_ID) <= 93 THEN 'Rare'
            WHEN COUNT(b.BOOKING_ID) > 93 AND COUNT(b.BOOKING_ID) <= 100 THEN 'Occasional'
            ELSE 'Frequent'
        END AS frequency_segment,
        
        CASE --- revenue_per_night_segment
            WHEN AVG(b.REVENUE_PER_NIGHT) <= 7.0727 THEN 'Budget'
            WHEN AVG(b.REVENUE_PER_NIGHT) > 7.0727 AND AVG(b.REVENUE_PER_NIGHT) <= 7.4301 THEN 'Midrange'
            ELSE 'Premium'
        END AS revenue_per_night_segment,
        
        CASE --- recency_segment
            WHEN (DATE '2024-11-07' - MAX(b.CHECK_OUT_DATE)) <= 39 THEN 'Low Recency'
            WHEN (DATE '2024-11-07' - MAX(b.CHECK_OUT_DATE)) > 39 AND (DATE '2024-11-07' - MAX(b.CHECK_OUT_DATE)) <= 46 THEN 'Medium Recency'
            ELSE 'High Recency'
        END AS recency_segment,

        CASE --- stay_duration_segment
            WHEN AVG(b.stay_duration) <= 1.9406 THEN 'Short Stay'
            WHEN AVG(b.stay_duration) > 1.9406 AND AVG(b.stay_duration) <= 2.0524 THEN 'Medium Stay'
            ELSE 'Long Stay'
        END AS stay_duration_segment

    FROM booking_df b
    GROUP BY b.USER_ID
)

UPDATE user_df
SET 
    revenue_segment = s.revenue_segment,
    frequency_segment = s.frequency_segment,
    revenue_per_night_segment = s.revenue_per_night_segment,
    recency_segment = s.recency_segment,
    stay_duration_segment = s.stay_duration_segment
FROM segmentasi s
WHERE user_df.USER_ID = s.USER_ID;

select
