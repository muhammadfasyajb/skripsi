WITH ScoredUsers AS (
    SELECT 
        USER_ID,
        -- Hitung Total Skor
        (CASE revenue_segment 
            WHEN 'High' THEN 5 WHEN 'Medium' THEN 3 ELSE 1 END) +
        (CASE recency_segment 
            WHEN 'High Recency' THEN 5 WHEN 'Medium Recency' THEN 3 ELSE 1 END) +
        (CASE frequency_segment 
            WHEN 'Frequent' THEN 5 WHEN 'Occasional' THEN 3 ELSE 1 END) +
        (CASE revenue_per_night_segment 
            WHEN 'Premium' THEN 5 WHEN 'Midrange' THEN 3 ELSE 1 END) +
        (CASE stay_duration_segment 
            WHEN 'Long Stay' THEN 5 WHEN 'Medium Stay' THEN 3 ELSE 1 END) AS total_score
    FROM user_df
)
SELECT 
    USER_ID,
    total_score,
    -- Kategori Berdasarkan Total Skor
    CASE
        WHEN total_score >= 20 THEN 'Most Valuable'
        WHEN total_score BETWEEN 15 AND 19 THEN 'Loyal'
        WHEN total_score BETWEEN 11 AND 14 THEN 'Potentially Loyal'
        WHEN total_score BETWEEN 6 AND 10 THEN 'Need Attention'
        ELSE 'Lost Sheep'
    END AS user_category
FROM ScoredUsers
ORDER BY total_score DESC;
SELECT 
    user_category, 
    COUNT(*) AS user_count
FROM user_df
GROUP BY user_category
ORDER BY user_count DESC;

----- Compare normal season vs. peak season pricing in 2023 and 2024 to determine if the company's pricing strategy aligned with seasonal demand -----
----- monthly occupancy rate ------
WITH Inventory_Per_Property AS (
    SELECT 
        b.PROPERTY_CODE,
        p.INVENTORY AS Property_Inventory  -- Mengambil inventory dari property_df
    FROM 
        booking_df b
    JOIN 
        property_df p ON b.PROPERTY_CODE = p.PROPERTY_CODE  -- Menggabungkan dengan property_df untuk mendapatkan inventory
    GROUP BY 
        b.PROPERTY_CODE, p.INVENTORY
),
Total_Inventory AS (
    SELECT
        SUM(Property_Inventory) AS Total_Inventory 
    FROM Inventory_Per_Property
),
Room_Nights_Per_Month AS (
    SELECT 
        DATE_TRUNC('month', CHECK_IN_DATE) AS Month,
        EXTRACT(YEAR FROM CHECK_IN_DATE) AS Year,
        SUM(ROOM_NIGHTS) AS Total_Room_Nights_Booked 
    FROM booking_df
    WHERE EXTRACT(YEAR FROM CHECK_IN_DATE) IN (2023, 2024)  -- Batasan untuk tahun 2023 dan 2024
    GROUP BY DATE_TRUNC('month', CHECK_IN_DATE), EXTRACT(YEAR FROM CHECK_IN_DATE)
)
SELECT 
    r.Month,
    r.Total_Room_Nights_Booked,
    t.Total_Inventory * 30 AS Total_Inventory_Month,  -- Total Inventory untuk satu bulan (diasumsikan 30 hari)
    (r.Total_Room_Nights_Booked * 100.0) / (t.Total_Inventory * 30) AS Occupancy_Rate 
FROM Room_Nights_Per_Month r
CROSS JOIN Total_Inventory t 
ORDER BY r.Month;
------- peak normal
SELECT SEASON,
       EXTRACT(YEAR FROM CHECK_IN_DATE) AS YEAR,
       COUNT(BOOKING_ID) AS Total_Bookings,
       SUM(revenue_dollar) AS Total_Revenue,
       SUM (ROOMS) as Total_Rooms,
       SUM(revenue_dollar) / SUM(ROOMS) AS ADR  -- Menghitung ADR dengan Total Revenue dibagi Total Rooms Sold
FROM (
    SELECT *,
           CASE 
               WHEN CHECK_IN_DATE BETWEEN '2023-12-15' AND '2024-01-15' THEN 'Peak Season'
               WHEN CHECK_IN_DATE BETWEEN '2023-06-20' AND '2023-08-31' THEN 'Peak Season'
               WHEN CHECK_IN_DATE BETWEEN '2024-06-20' AND '2024-08-31' THEN 'Peak Season'
               WHEN CHECK_IN_DATE BETWEEN '2023-04-20' AND '2023-05-01' THEN 'Peak Season'
               WHEN CHECK_IN_DATE BETWEEN '2024-04-05' AND '2024-04-20' THEN 'Peak Season'
               ELSE 'Normal Season'
           END AS SEASON
    FROM booking_df
    WHERE EXTRACT(YEAR FROM CHECK_IN_DATE) IN (2023, 2024)
) AS season_data
GROUP BY SEASON, EXTRACT(YEAR FROM CHECK_IN_DATE)
ORDER BY YEAR, SEASON;
